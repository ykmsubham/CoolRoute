# PostgreSQL (psycopg3 driver). Leave unset to fall back to a local SQLite file for quick demos.
DATABASE_URL=postgresql+psycopg://coolroute:coolroute@localhost:5432/coolroute

# LLM explainer. Claude is tried first, then Gemini, then a built-in template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Razorpay (use test keys: rzp_test_...). Leave unset for mock checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
